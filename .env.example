# RaktSetu Frontend — Environment

# URL of the RaktSetu Express backend.
# Local dev:  http://localhost:5000/api
# Production: https://your-backend.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# When "true", the frontend uses built-in demo data and never calls the backend.
# Lets you preview/deploy the UI before the backend is live. Set "false" to use the real API.
NEXT_PUBLIC_USE_MOCK=true

# Public site URL (for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:4028
